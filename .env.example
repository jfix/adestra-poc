# Copy to .env and fill in. The token stays on the server; it is never sent to the browser.

# Adestra host. Usually app.adestra.com; use your account's custom host if you have one.
ADESTRA_DOMAIN=app.adestra.com

# API token created in Adestra under your user -> "manage API tokens" (needs write access).
ADESTRA_API_TOKEN=

# Numeric id of the list to subscribe to (visible in the list URL: .../data/list/<id>/view).
ADESTRA_LIST_ID=

# Numeric id of the PUBLISHED campaign that is your welcome / double-opt-in email.
# send_single refuses unpublished campaigns (409) and campaigns tied to a dynamic list.
ADESTRA_CAMPAIGN_ID=

# Set to 1 to fake all API calls (lets you try the UI without credentials).
ADESTRA_MOCK=0

PORT=3000

# ---------------------------------------------------------------------------
# Form relay (default mode). The server posts these fields server-to-server to the
# Adestra form handler, exactly like an Adestra static form on your site would.
# ---------------------------------------------------------------------------
# form | api
ADESTRA_MODE=form

# Form handler URL. For static/bespoke forms this is https://<your msgfocus or delegated domain>/s/
# For a Form Builder form, download the "Unstyled Form" in Adestra and copy its <form action="...">.
ADESTRA_FORM_URL=

# Hidden fields the Adestra form expects, URL-encoded. Copy them from the downloaded form.
# Static form example (ids are placeholders):
#   _account_id=180&_table_id=1&_dedupe=1&_email_field=1.email&_list_id=4398
# Add _list_id twice to subscribe to two lists. Do NOT put _rp here; it is set from ADESTRA_FORM_RETURN_URL.
ADESTRA_FORM_HIDDEN=

# Names of the email and (optional) first-name inputs in the Adestra form ("<table_id>.<field>").
ADESTRA_FORM_EMAIL_FIELD=1.email
ADESTRA_FORM_FIRSTNAME_FIELD=1.firstname

# Return URL (_rp). The handler redirects here on success; the relay treats that redirect as
# "accepted" and never follows it, so it can be any URL, even one that does not exist.
ADESTRA_FORM_RETURN_URL=https://example.invalid/adestra-poc-ok
